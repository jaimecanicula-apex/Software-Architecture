        </mxCell>
        <mxCell id="3" parent="1" vertex="1" value="Approved external guests (B2B guests of the APEX tenant) reach the site through Front Door and its WAF. Every page except /healthz.html sends visitors without a session to Entra ID; only assigned groups get in. Application Insights tests the anonymous health page from five regions." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5c5c5c;">
          <mxGeometry x="20" y="62" width="1010" height="60" as="geometry" />
        </mxCell>
