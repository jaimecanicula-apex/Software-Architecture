<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" type="device">
  <diagram name="C4 L2 Containers - private static website with storage" id="c4-containers">
    <mxGraphModel dx="1700" dy="1585" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1585" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Privately accessible static website with storage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#b8321f&quot;&gt;C4 level 2: Containers&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1c1c1c;strokeColor=none;fillColor=none;" vertex="1">
          <mxGeometry as="geometry" x="20" y="10" width="1660" height="50" />
        </mxCell>
        <mxCell id="description" parent="1" value="Inside one environment&amp;#x27;s resource group: users on the corporate network reach a private endpoint through hub peering; the Private DNS zones, linked to the spoke and the hub, resolve both the site and the storage account. Entra built-in authentication signs them in to the Static Web App. The site&amp;#x27;s page then signs the user in again with MSAL.js and calls the private Blob container directly with the user&amp;#x27;s own token; a custom role on the container decides who may list, upload, download and delete. Blob logs, the availability probe and alerts feed Log Analytics. Nothing is reachable from the internet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5c5c5c;strokeColor=none;fillColor=none;" vertex="1">
          <mxGeometry as="geometry" x="20" y="62" width="1660" height="60" />
        </mxCell>
        <mxCell id="rg" parent="1" value=" Resource group · rg-&amp;lt;workload&amp;gt;-&amp;lt;env&amp;gt;-&amp;lt;region&amp;gt;-001 " style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#e6e6ea;strokeColor=#a9a9b4;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;labelBackgroundColor=#1c1c1c;" vertex="1">
          <mxGeometry as="geometry" x="290" y="200" width="1130" height="610" />
        </mxCell>
        <mxCell id="vnet" parent="1" value=" Spoke VNet · snet-pe-&amp;lt;suffix&amp;gt; and snet-probe-&amp;lt;suffix&amp;gt; · NSGs " style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#9c9cf2;strokeColor=#7a7ad6;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;labelBackgroundColor=#1c1c1c;" vertex="1">
          <mxGeometry as="geometry" x="310" y="240" width="1090" height="350" />
