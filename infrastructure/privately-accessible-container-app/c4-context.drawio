        <mxCell id="description" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5c5c5c;strokeColor=none;fillColor=none;" value="Internal users on the corporate network reach the app through the hub and sign in with Entra ID; only allowed groups get in. Monitoring viewers read its logs and a platform engineer provisions it with Terraform. Azure DevOps builds and deploys new images after a release approver signs off, and alerts go to email." vertex="1">
