<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" type="device">
  <diagram name="C4 L2 Containers - private container app" id="c4-containers">
    <mxGraphModel dx="1700" dy="1565" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1565" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Privately accessible container app&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#b8321f&quot;&gt;C4 level 2: Containers&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1c1c1c;strokeColor=none;fillColor=none;" vertex="1">
          <mxGeometry as="geometry" x="20" y="10" width="1660" height="50" />
        </mxCell>
        <mxCell id="description" parent="1" value="Inside one environment&amp;#x27;s resource group: users on the corporate network reach the internal load balancer of the Container Apps environment through hub peering; the Private DNS zone, linked to the spoke and the hub, resolves the app name. Built-in authentication signs them in with Entra ID before any request reaches the web application, which is generic: any image that serves HTTP on port 8000 and answers /healthz. It pulls its image from the registry with a managed identity, sends traces, requests and exceptions to Application Insights, and alerts fire through the Action Group. Nothing is reachable from the internet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5c5c5c;strokeColor=none;fillColor=none;" vertex="1">
          <mxGeometry as="geometry" x="20" y="62" width="1660" height="60" />
        </mxCell>
        <mxCell id="rg" parent="1" value=" Resource group · rg-&amp;lt;workload&amp;gt;-&amp;lt;env&amp;gt;-&amp;lt;region&amp;gt;-001 " style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#e6e6ea;strokeColor=#a9a9b4;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;labelBackgroundColor=#1c1c1c;" vertex="1">
          <mxGeometry as="geometry" x="290" y="200" width="1130" height="600" />
        </mxCell>
        <mxCell id="vnet" parent="1" value=" Spoke VNet · snet-cae-&amp;lt;suffix&amp;gt; · NSG denies internet inbound · zone-redundant in uat and prod " style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#9c9cf2;strokeColor=#7a7ad6;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;labelBackgroundColor=#1c1c1c;" vertex="1">
          <mxGeometry as="geometry" x="310" y="240" width="820" height="180" />
        </mxCell>
