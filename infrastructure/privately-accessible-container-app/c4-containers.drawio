        </mxCell>
        <mxCell id="gov" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Governance&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Mandatory tags, budget,&lt;br&gt;delete lock in uat and prod&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[Resource group scope]&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;whiteSpace=wrap;html=1;fontColor=#1c1c1c;fontSize=12;verticalAlign=top;arcSize=8;fillColor=#ffffff;strokeColor=#c4c4d6;strokeWidth=1;spacingTop=40;" vertex="1">
          <mxGeometry as="geometry" x="1170" y="660" width="220" height="110" />
        </mxCell>
        <mxCell id="gov-icon" parent="gov" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
          <mxGeometry as="geometry" x="96.0" y="8" width="28" height="28" />
        </mxCell>
        <mxCell id="user" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Internal user&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Allowed Entra group&lt;/span&gt;" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;aspect=fixed;imageAspect=0;fontSize=12;fontColor=#1c1c1c;spacingTop=6;image=data:image/svg+xml,;" vertex="1">
          <mxGeometry as="geometry" x="118" y="150" width="44" height="44" />
        </mxCell>
        <mxCell id="viewer" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Monitoring viewer&lt;/b&gt;" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;aspect=fixed;imageAspect=0;fontSize=12;fontColor=#1c1c1c;spacingTop=6;image=data:image/svg+xml,;" vertex="1">
          <mxGeometry as="geometry" x="118" y="690" width="44" height="44" />
        </mxCell>
        <mxCell id="hub" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Hub VNet + corporate DNS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Platform team&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;whiteSpace=wrap;html=1;fontColor=#1c1c1c;fontSize=12;verticalAlign=top;arcSize=12;fillColor=#f7f6f4;strokeColor=#8a8781;dashed=1;dashPattern=5 4;spacingTop=37;" vertex="1">
          <mxGeometry as="geometry" x="40" y="305" width="200" height="80" />
        </mxCell>
        <mxCell id="hub-icon" parent="hub" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
