<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" type="device">
  <diagram name="C4 L2 Containers - private container app with database and storage" id="c4-containers">
    <mxGraphModel dx="1750" dy="1730" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1730" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Privately accessible container app with database and storage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#b8321f&quot;&gt;C4 level 2: Containers&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1c1c1c;strokeColor=none;fillColor=none;" vertex="1">
          <mxGeometry as="geometry" x="20" y="10" width="1710" height="50" />
        </mxCell>
        <mxCell id="description" parent="1" value="Inside one environment&amp;#x27;s resource group: users reach the internal load balancer of the Container Apps environment through hub peering. Built-in authentication signs them in with Entra ID, then the web application&amp;#x27;s own login signs them in a second time. The app reads its secrets from Key Vault, its data from a VNet-integrated PostgreSQL Flexible Server, and its image files from a private-endpoint Storage account, all through one managed identity and never a stored key or password outside Key Vault. It pulls its image from the registry, sends traces to Application Insights, and alerts fire through the Action Group for the app, the database and storage capacity. Nothing is reachable from the internet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5c5c5c;strokeColor=none;fillColor=none;" vertex="1">
          <mxGeometry as="geometry" x="20" y="62" width="1710" height="60" />
        </mxCell>
        <mxCell id="rg" parent="1" value=" Resource group · rg-pcds-&amp;lt;env&amp;gt;-&amp;lt;region&amp;gt;-001 " style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#e6e6ea;strokeColor=#a9a9b4;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;labelBackgroundColor=#1c1c1c;" vertex="1">
          <mxGeometry as="geometry" x="290" y="200" width="1150" height="790" />
        </mxCell>
        <mxCell id="vnet" parent="1" value=" Spoke VNet · snet-cae / snet-pg (delegated) / snet-pe · NSGs deny internet inbound " style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#9c9cf2;strokeColor=#7a7ad6;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;labelBackgroundColor=#1c1c1c;" vertex="1">
