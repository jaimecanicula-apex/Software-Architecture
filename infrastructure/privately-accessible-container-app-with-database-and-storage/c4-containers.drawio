        <mxCell id="pipeline" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Delivery pipeline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Azure DevOps, OIDC&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;whiteSpace=wrap;html=1;fontColor=#1c1c1c;fontSize=12;verticalAlign=top;arcSize=12;fillColor=#f7f6f4;strokeColor=#8a8781;dashed=1;dashPattern=5 4;spacingTop=37;" vertex="1">
