        <mxCell id="c7" parent="1" value="Sends alerts" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3c3c3c;strokeWidth=1;endArrow=block;endFill=1;fontSize=10;fontColor=#1c1c1c;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 4;" edge="1" source="sys" target="notify"><mxGeometry relative="1" as="geometry" /></mxCell>
