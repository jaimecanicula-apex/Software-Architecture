<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device">
  <diagram name="C4 L1 System context - public website with document API" id="c4-context">
    <mxGraphModel dx="1000" dy="720" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1000" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Public static website with a document API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#b8321f&quot;&gt;C4 level 1: System context&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1c1c1c;strokeColor=none;fillColor=none;" vertex="1"><mxGeometry as="geometry" x="20" y="10" width="960" height="50" /></mxCell>
        <mxCell id="description" parent="1" value="Visitors read published documents over HTTPS. Publishers upload approved PDFs with their Entra ID identity. A platform engineer deploys the template with Bicep. Delivery pipelines publish the site and the API, a DNS provider routes custom domains, and alerts go to notification channels." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1c1c1c;strokeColor=none;fillColor=none;fontSize=12;fontColor=#5c5c5c;" vertex="1"><mxGeometry as="geometry" x="20" y="62" width="960" height="50" /></mxCell>
        <mxCell id="b" parent="1" value="  Public website system Â· one per environment  " style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#e6e6ea;strokeColor=#a9a9b4;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;labelBackgroundColor=#1c1c1c;" vertex="1"><mxGeometry as="geometry" x="300" y="250" width="400" height="320" /></mxCell>
        <mxCell id="sys" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Public website with document API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Front Door and WAF, static site,&lt;br&gt;private document API and storage,&lt;br&gt;monitoring&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[software system]&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#1c1c1c;fontSize=12;verticalAlign=top;fillColor=#fbeeeb;strokeColor=#b8321f;strokeWidth=2;spacingTop=10;" vertex="1"><mxGeometry as="geometry" x="380" y="335" width="240" height="150" /></mxCell>
        <mxCell id="visitor" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Public visitor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Reads documents&lt;/span&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#1c1c1c;strokeWidth=2;fontSize=12;fontColor=#1c1c1c;spacingTop=6;" vertex="1"><mxGeometry as="geometry" x="68" y="180" width="44" height="52" /></mxCell>
        <mxCell id="publisher" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Publisher&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Uploads approved PDFs&lt;/span&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#1c1c1c;strokeWidth=2;fontSize=12;fontColor=#1c1c1c;spacingTop=6;" vertex="1"><mxGeometry as="geometry" x="68" y="370" width="44" height="52" /></mxCell>
        <mxCell id="engineer" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Platform engineer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Deploys and operates&lt;/span&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#1c1c1c;strokeWidth=2;fontSize=12;fontColor=#1c1c1c;spacingTop=6;" vertex="1"><mxGeometry as="geometry" x="68" y="560" width="44" height="52" /></mxCell>
        <mxCell id="entra" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Publisher sign-in and roles&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontColor=#1c1c1c;fontSize=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#9a9aa8;dashed=1;dashPattern=5 4;spacingTop=10;" vertex="1"><mxGeometry as="geometry" x="770" y="150" width="200" height="80" /></mxCell>
        <mxCell id="pipe" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Delivery pipelines&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Site and Function packages&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontColor=#1c1c1c;fontSize=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#9a9aa8;dashed=1;dashPattern=5 4;spacingTop=10;" vertex="1"><mxGeometry as="geometry" x="770" y="290" width="200" height="80" /></mxCell>
        <mxCell id="dns" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;DNS provider&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Custom domains&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontColor=#1c1c1c;fontSize=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#9a9aa8;dashed=1;dashPattern=5 4;spacingTop=10;" vertex="1"><mxGeometry as="geometry" x="770" y="430" width="200" height="80" /></mxCell>
        <mxCell id="notify" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Notification channels&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Email, webhooks&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontColor=#1c1c1c;fontSize=12;verticalAlign=top;fillColor=#ffffff;strokeColor=#9a9aa8;dashed=1;dashPattern=5 4;spacingTop=10;" vertex="1"><mxGeometry as="geometry" x="770" y="570" width="200" height="80" /></mxCell>
        <mxCell id="c1" parent="1" value="Reads over HTTPS" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3c3c3c;strokeWidth=1;endArrow=block;endFill=1;fontSize=10;fontColor=#1c1c1c;labelBackgroundColor=#ffffff;" edge="1" source="visitor" target="sys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" parent="1" value="Uploads PDFs" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3c3c3c;strokeWidth=1;endArrow=block;endFill=1;fontSize=10;fontColor=#1c1c1c;labelBackgroundColor=#ffffff;" edge="1" source="publisher" target="sys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" parent="1" value="Deploys with Bicep" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3c3c3c;strokeWidth=1;endArrow=block;endFill=1;fontSize=10;fontColor=#1c1c1c;labelBackgroundColor=#ffffff;" edge="1" source="engineer" target="sys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4" parent="1" value="Authorizes publishers" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3c3c3c;strokeWidth=1;endArrow=block;endFill=1;fontSize=10;fontColor=#1c1c1c;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 4;" edge="1" source="sys" target="entra"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c5" parent="1" value="Publishes site and API" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3c3c3c;strokeWidth=1;endArrow=block;endFill=1;fontSize=10;fontColor=#1c1c1c;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 4;" edge="1" source="pipe" target="sys"><mxGeometry relative="1" as="geometry" /></mxCell>
