        <mxCell id="c6-l" value="Managed identity" style="text;fillColor=#FFFFFF;strokeColor=none;fontColor=#1C1C1C;fontSize=10;align=center;verticalAlign=middle;fontFamily=Helvetica;html=0;" vertex="1" parent="1"><mxGeometry x="626" y="591" width="107" height="19" as="geometry"/></mxCell>
        <mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#3C3C3C;strokeWidth=1;endArrow=block;endFill=1;" edge="1" source="pe" target="store" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c7-l" value="Private link" style="text;fillColor=#FFFFFF;strokeColor=none;fontColor=#1C1C1C;fontSize=10;align=center;verticalAlign=middle;fontFamily=Helvetica;html=0;" vertex="1" parent="1"><mxGeometry x="478" y="691" width="84" height="19" as="geometry"/></mxCell>
        <mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#3C3C3C;strokeWidth=1;endArrow=block;endFill=1;dashed=1;dashPattern=5 4;" edge="1" source="pe" target="dnsz" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c8-l" value="Resolves names" style="text;fillColor=#FFFFFF;strokeColor=none;fontColor=#1C1C1C;fontSize=10;align=center;verticalAlign=middle;fontFamily=Helvetica;html=0;" vertex="1" parent="1"><mxGeometry x="772" y="681" width="95" height="19" as="geometry"/></mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#3C3C3C;strokeWidth=1;endArrow=block;endFill=1;dashed=1;dashPattern=5 4;" edge="1" source="pipe" target="swa" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c9-l" value="Deploys site" style="text;fillColor=#FFFFFF;strokeColor=none;fontColor=#1C1C1C;fontSize=10;align=center;verticalAlign=middle;fontFamily=Helvetica;html=0;" vertex="1" parent="1"><mxGeometry x="188" y="451" width="84" height="19" as="geometry"/></mxCell>
        <mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#3C3C3C;strokeWidth=1;endArrow=block;endFill=1;" edge="1" source="publisher" target="store" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c10-l" value="Uploads PDFs" style="text;fillColor=#FFFFFF;strokeColor=none;fontColor=#1C1C1C;fontSize=10;align=center;verticalAlign=middle;fontFamily=Helvetica;html=0;" vertex="1" parent="1"><mxGeometry x="182" y="677" width="84" height="19" as="geometry"/></mxCell>
        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#3C3C3C;strokeWidth=1;endArrow=block;endFill=1;dashed=1;dashPattern=5 4;" edge="1" source="publisher" target="entra" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c11-l" value="Signs in" style="text;fillColor=#FFFFFF;strokeColor=none;fontColor=#1C1C1C;fontSize=10;align=center;verticalAlign=middle;fontFamily=Helvetica;html=0;" vertex="1" parent="1"><mxGeometry x="69" y="761" width="60" height="19" as="geometry"/></mxCell>
        <mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#3C3C3C;strokeWidth=1;endArrow=block;endFill=1;" edge="1" source="ai" target="alerts" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c12-l" value="Test results" style="text;fillColor=#FFFFFF;strokeColor=none;fontColor=#1C1C1C;fontSize=10;align=center;verticalAlign=middle;fontFamily=Helvetica;html=0;" vertex="1" parent="1"><mxGeometry x="928" y="941" width="84" height="19" as="geometry"/></mxCell>
        <mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#3C3C3C;strokeWidth=1;endArrow=block;endFill=1;dashed=1;dashPattern=5 4;" edge="1" source="law" target="ai" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c13-l" value="Stores telemetry" style="text;fillColor=#FFFFFF;strokeColor=none;fontColor=#1C1C1C;fontSize=10;align=center;verticalAlign=middle;fontFamily=Helvetica;html=0;" vertex="1" parent="1"><mxGeometry x="676" y="941" width="107" height="19" as="geometry"/></mxCell>
        <mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#3C3C3C;strokeWidth=1;endArrow=block;endFill=1;" edge="1" source="alerts" target="ag" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c14-l" value="Fires" style="text;fillColor=#FFFFFF;strokeColor=none;fontColor=#1C1C1C;fontSize=10;align=center;verticalAlign=middle;fontFamily=Helvetica;html=0;" vertex="1" parent="1"><mxGeometry x="1184" y="941" width="43" height="19" as="geometry"/></mxCell>
        <mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#3C3C3C;strokeWidth=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ag" target="notify" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c15-l" value="Email, webhook" style="text;fillColor=#FFFFFF;strokeColor=none;fontColor=#1C1C1C;fontSize=10;align=center;verticalAlign=middle;fontFamily=Helvetica;html=0;" vertex="1" parent="1"><mxGeometry x="1442" y="936" width="95" height="19" as="geometry"/></mxCell>
        <mxCell id="note-1" value="" style="rounded=1;arcSize=3;fillColor=#F7F7FF;strokeColor=#B9B9E6;dashed=1;dashPattern=4 4;fontFamily=Helvetica;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="1190" width="840" height="392" as="geometry"/></mxCell>
        <mxCell id="note-1-t" value="Request and publishing paths: what they do and why" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;html=0;fontColor=#1C1C1C;fontSize=14;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="note-1"><mxGeometry x="12" y="10" width="816" height="20" as="geometry"/></mxCell>
        <mxCell id="note-1-b" value="Website path: Front Door ends TLS, redirects HTTP to HTTPS, applies the WAF and routes /* to the Static Web App. The Static Web App accepts only AzureFrontDoor.Backend traffic that carries this profile&apos;s X-Azure-FDID header and a listed forwarded host, so the default azurestaticapps.net address cannot bypass the WAF.&#xa;&#xa;API path: /api/* goes to the Function App through a Private Link connection that Front Door requests and the deploy script approves. The Function has public network access disabled, so Front Door is the only way in.&#xa;&#xa;Read path: The Function signs in with its system-assigned identity (Storage Blob Data Reader), lists or streams blobs over the private endpoint, keeps only .pdf blobs with approved=true and answers 404 for missing and unapproved alike.&#xa;&#xa;Publish path: Publishers sign in with Entra ID (Storage Blob Data Contributor) and upload PDFs with approved=true over the storage public endpoint. No network path and no code release are needed.&#xa;&#xa;No caching: /api/* has no cache rule and responses are no-store, so a publication or withdrawal shows at once.&#xa;&#xa;Checks: Standard web tests open / and /api/documents every 5 minutes from 3 locations and check the certificate. Alerts cover Front Door 5xx and origin health, and Function 5xx.&#xa;&#xa;Does not prove: that a document is correct or approved by the business (approved=true is a process control), that the Function code is deployed, or that DNS and certificates for custom domains are valid.&#xa;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;html=0;fontColor=#1C1C1C;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="note-1"><mxGeometry x="12" y="34" width="816" height="348" as="geometry"/></mxCell>
        <mxCell id="note-2" value="" style="rounded=1;arcSize=3;fillColor=#F7F7FF;strokeColor=#B9B9E6;dashed=1;dashPattern=4 4;fontFamily=Helvetica;html=0;" vertex="1" parent="1"><mxGeometry x="920" y="1190" width="840" height="216" as="geometry"/></mxCell>
        <mxCell id="note-2-t" value="The same story in plain language" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;html=0;fontColor=#1C1C1C;fontSize=14;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="note-2"><mxGeometry x="12" y="10" width="816" height="20" as="geometry"/></mxCell>
        <mxCell id="note-2-b" value="What happens&#xa;â€¢ A visitor opens the website. A security gate in front of it checks the request and shows the page&#xa;â€¢ The page asks for the list of documents. That request goes to a private service that nobody can reach directly&#xa;â€¢ The private service reads the documents from locked storage and shows only the ones marked approved&#xa;â€¢ A publisher adds or removes documents without changing any code&#xa;Why we do it this way&#xa;â€¢ The public only ever meets the security gate, never the storage or the service behind it&#xa;â€¢ The service has its own identity, so there are no passwords or keys in the code&#xa;â€¢ Tests check the site and the document list every 5 minutes and alert the team when they fail&#xa;â€¢ The same shape in every environment means testing in dev tells us what production will do" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;html=0;fontColor=#1C1C1C;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="note-2"><mxGeometry x="12" y="34" width="816" height="172" as="geometry"/></mxCell>
        <mxCell id="note-3" value="" style="rounded=1;arcSize=3;fillColor=#F7F7FF;strokeColor=#B9B9E6;dashed=1;dashPattern=4 4;fontFamily=Helvetica;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="1612" width="840" height="392" as="geometry"/></mxCell>
        <mxCell id="note-3-t" value="What to keep in mind" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;html=0;fontColor=#1C1C1C;fontSize=14;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="note-3"><mxGeometry x="12" y="10" width="816" height="20" as="geometry"/></mxCell>
        <mxCell id="note-3-b" value="Origin lock is a pipeline step: the Static Web App accepts only this Front Door once the site pipeline writes staticwebapp.config.json from SWA_CONFIG_JSON. The Front Door ID changes if Front Door is recreated.&#xa;&#xa;Private Link is approved by script: the connection is created Pending. Until deploy.sh approves it, /api/* fails.&#xa;&#xa;Function deployment needs a private path: its package is deployed over its private endpoint, so the deploy job must run on an agent inside the network.&#xa;&#xa;Custom domains: each needs a DNS validation record before its managed certificate is issued, and certificate renewal depends on the DNS provider.&#xa;&#xa;Weakest link: storage keeps shared-key access on for the Function host and accepts authenticated requests from any network. Treat the account keys as secrets.&#xa;&#xa;Access: publishers are Entra groups, viewers and operators get Reader and Monitoring Contributor on the resource group.&#xa;&#xa;Cost: about $553 a month fixed in dev and qa, about $707 in uat and prod (retail prices, West Europe, 2026-10-30). Front Door Premium is $330 of that and one EP1 instance is about $154. Traffic is extra. Budgets: 600 in dev and qa, 800 in uat, 900 in prod.&#xa;&#xa;Status: nothing has been built or deployed.&#xa;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;html=0;fontColor=#1C1C1C;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="note-3"><mxGeometry x="12" y="34" width="816" height="348" as="geometry"/></mxCell>
        <mxCell id="note-4" value="" style="rounded=1;arcSize=3;fillColor=#F7F7FF;strokeColor=#B9B9E6;dashed=1;dashPattern=4 4;fontFamily=Helvetica;html=0;" vertex="1" parent="1"><mxGeometry x="920" y="1612" width="840" height="408" as="geometry"/></mxCell>
        <mxCell id="note-4-t" value="Why pick this design, and its trade-offs" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;html=0;fontColor=#1C1C1C;fontSize=14;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="note-4"><mxGeometry x="12" y="10" width="816" height="20" as="geometry"/></mxCell>
        <mxCell id="note-4-b" value="Front Door Premium in every environment, not Standard in dev: Private Link origins and managed WAF rules need Premium, and one shape everywhere means dev tests what prod runs. Trade-off: $330 a month even in dev.&#xa;&#xa;Private Link to the Function, not a public API with restrictions: the API cannot be called except through the WAF. Trade-off: the connection must be approved and deployments need a private network path.&#xa;&#xa;Elastic Premium EP1, not Consumption: VNet integration with private endpoints and a warm instance, so no cold start. Trade-off: about $154 a month per instance with no traffic.&#xa;&#xa;One storage account, not two: the Function host and the documents share an account, matching the reviewed design and keeping publishing simple. Trade-off: shared-key access stays on and the endpoint is open to authenticated requests from any network; the hardened option is two accounts with a private publishing path.&#xa;&#xa;Managed identity, not keys or SAS: a compromised API cannot write or delete documents. Trade-off: the Reader role is account-wide, not per container.&#xa;&#xa;Zone redundancy on in uat and prod: a zone failure should not take the API offline. Trade-off: two EP1 instances double the compute cost and the setting is fixed at creation. Front Door and Static Web Apps are global, so they have no zone setting.&#xa;&#xa;Deployment stack per environment, not Terraform state: removes what you remove from the template with nothing to bootstrap. Trade-off: the stack is the only record and there is no plan file.&#xa;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;html=0;fontColor=#1C1C1C;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="note-4"><mxGeometry x="12" y="34" width="816" height="364" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
