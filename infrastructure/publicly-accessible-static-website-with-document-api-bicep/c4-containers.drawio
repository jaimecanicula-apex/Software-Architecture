  <diagram name="C4 L2 Containers - public website with document API" id="c4-containers">
    <mxGraphModel dx="1800" dy="2060" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Public static website with a document API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#b8321f&quot;&gt;C4 level 2: Containers&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1c1c1c;strokeColor=none;fillColor=none;" vertex="1"><mxGeometry as="geometry" x="20" y="10" width="1760" height="50" /></mxCell>
        <mxCell id="description" parent="1" value="One environment. Requests pass Front Door and the WAF. The website goes to the Static Web App; /api/* goes through Private Link to the Function App, which reads the private document container with its managed identity over a private endpoint. Publishers upload PDFs with Entra ID." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1c1c1c;strokeColor=none;fillColor=none;fontSize=12;fontColor=#5c5c5c;" vertex="1"><mxGeometry as="geometry" x="20" y="62" width="1760" height="50" /></mxCell>
        <mxCell id="edge" parent="1" value="  Public edge Â· global  " style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#9c9cf2;strokeColor=#7a7ad6;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;labelBackgroundColor=#1c1c1c;" vertex="1"><mxGeometry as="geometry" x="200" y="170" width="520" height="170" /></mxCell>
        <mxCell id="rg" parent="1" value="  Resource group Â· rg-doc-&lt;env&gt;-&lt;region&gt;-001  " style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#e6e6ea;strokeColor=#a9a9b4;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;labelBackgroundColor=#1c1c1c;" vertex="1"><mxGeometry as="geometry" x="200" y="370" width="1300" height="770" /></mxCell>
        <mxCell id="vnet" parent="1" value="  VNet Â· vnet-doc-&lt;env&gt;-&lt;region&gt;-001  " style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#d8d2f0;strokeColor=#8a6fc9;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;labelBackgroundColor=#1c1c1c;" vertex="1"><mxGeometry as="geometry" x="520" y="400" width="720" height="420" /></mxCell>
        <mxCell id="mon" parent="1" value="  Monitoring and governance  " style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#9c9cf2;strokeColor=#7a7ad6;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;labelBackgroundColor=#1c1c1c;" vertex="1"><mxGeometry as="geometry" x="240" y="850" width="1240" height="250" /></mxCell>
        <mxCell id="fd" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Azure Front Door&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Premium. TLS, HTTPS redirect,&lt;br&gt;routes /* and /api/*,&lt;br&gt;no caching&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[Front Door profile]&lt;/i&gt;" style="" vertex="1"><mxGeometry as="geometry" x="230" y="205" width="220" height="110" /></mxCell>
        <mxCell id="waf" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;WAF policy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Managed and bot rules.&lt;br&gt;Prevention in uat and prod&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[Front Door WAF]&lt;/i&gt;" style="" vertex="1"><mxGeometry as="geometry" x="480" y="205" width="220" height="110" /></mxCell>
        <mxCell id="swa" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Static Web App&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Build-free frontend.&lt;br&gt;Accepts only this Front Door&lt;br&gt;(X-Azure-FDID)&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[Standard]&lt;/i&gt;" style="" vertex="1"><mxGeometry as="geometry" x="240" y="410" width="220" height="110" /></mxCell>
        <mxCell id="func" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Function App&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Lists and streams approved PDFs.&lt;br&gt;Public access off; identity&lt;br&gt;reads storage&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[Node 24, Elastic Premium EP1]&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#1c1c1c;fontSize=12;verticalAlign=top;fillColor=#fbeeeb;strokeColor=#b8321f;strokeWidth=2;spacingTop=10;" vertex="1"><mxGeometry as="geometry" x="560" y="440" width="240" height="130" /></mxCell>
        <mxCell id="snet" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Integration subnet&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Delegated to&lt;br&gt;Microsoft.Web/serverFarms.&lt;br&gt;NSG, route all traffic&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[Subnet]&lt;/i&gt;" style="" vertex="1"><mxGeometry as="geometry" x="850" y="440" width="220" height="110" /></mxCell>
        <mxCell id="pe" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Private endpoints&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Blob, file and Function.&lt;br&gt;In the private endpoint&lt;br&gt;subnet with an NSG&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[Private Link]&lt;/i&gt;" style="" vertex="1"><mxGeometry as="geometry" x="560" y="630" width="240" height="130" /></mxCell>
        <mxCell id="dnsz" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Private DNS zones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;blob, file and&lt;br&gt;azurewebsites, linked&lt;br&gt;to the VNet&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[Private DNS]&lt;/i&gt;" style="" vertex="1"><mxGeometry as="geometry" x="850" y="630" width="220" height="110" /></mxCell>
        <mxCell id="store" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Storage account&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Private container documents.&lt;br&gt;Also the Function host.&lt;br&gt;Soft delete 30 days&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[StorageV2, ZRS or GZRS]&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#1c1c1c;fontSize=12;verticalAlign=top;fillColor=#fbeeeb;strokeColor=#b8321f;strokeWidth=2;spacingTop=10;" vertex="1"><mxGeometry as="geometry" x="240" y="640" width="240" height="130" /></mxCell>
        <mxCell id="law" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Log Analytics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Front Door, WAF and blob&lt;br&gt;logs, metrics. Function&lt;br&gt;telemetry via App Insights&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[Workspace]&lt;/i&gt;" style="" vertex="1"><mxGeometry as="geometry" x="500" y="890" width="220" height="120" /></mxCell>
        <mxCell id="ai" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Application Insights&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Standard web tests from&lt;br&gt;3 locations every 5 min:&lt;br&gt;/ and /api/documents&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[Workspace-based]&lt;/i&gt;" style="" vertex="1"><mxGeometry as="geometry" x="740" y="890" width="220" height="120" /></mxCell>
        <mxCell id="alerts" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Alert rules&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Availability, Front Door&lt;br&gt;5xx and origin health,&lt;br&gt;Function 5xx&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[Azure Monitor]&lt;/i&gt;" style="" vertex="1"><mxGeometry as="geometry" x="980" y="890" width="220" height="120" /></mxCell>
        <mxCell id="ag" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Action Group&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Routes every alert&lt;br&gt;to its receivers&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[Azure Monitor]&lt;/i&gt;" style="" vertex="1"><mxGeometry as="geometry" x="1220" y="890" width="200" height="120" /></mxCell>
