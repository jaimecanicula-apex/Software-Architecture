# Where the PROD environment is deployed. Read by scripts/deploy.sh and deploy.ps1.
# Every environment gets its own subscription (and its own deployment stack).
SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000014 # <prod subscription id>
TENANT_ID=00000000-0000-0000-0000-00000000000a # <APEX tenant id>
# Entra group object IDs, comma separated, no spaces: who can sign in.
ALLOWED_GROUP_IDS=
