<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" type="device">
  <diagram name="C4 L1 System context - privately accessible" id="c4-context">
    <mxGraphModel dx="1000" dy="720" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1000" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Privately accessible static website&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#b8321f&quot;&gt;C4 level 1: System context&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1c1c1c;strokeColor=none;fillColor=none;" vertex="1">
          <mxGeometry as="geometry" x="20" y="10" width="960" height="50" />
        </mxCell>
        <mxCell id="description" parent="1" value="Internal users sign in with APEX Entra ID and browse the site over the APEX network. Monitoring viewers open its dashboard and a platform engineer deploys it with Bicep. A delivery pipeline uploads the site content, the APEX network carries private traffic, Entra ID authenticates users and alerts go to notification channels." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5c5c5c;strokeColor=none;fillColor=none;" vertex="1">
          <mxGeometry as="geometry" x="20" y="62" width="960" height="60" />
        </mxCell>
        <mxCell id="b" parent="1" value=" Internal static website · one per environment " style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#e6e6ea;strokeColor=#a9a9b4;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;labelBackgroundColor=#1c1c1c;" vertex="1">
          <mxGeometry as="geometry" x="300" y="250" width="400" height="320" />
        </mxCell>
        <mxCell id="sys" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Internal static website&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Private hosting, APEX&lt;br&gt;sign-in and monitoring&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#b8321f&quot;&gt;[software system]&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;whiteSpace=wrap;html=1;fontColor=#1c1c1c;fontSize=12;verticalAlign=top;arcSize=8;fillColor=#fbeeeb;strokeColor=#b8321f;strokeWidth=2;spacingTop=44;" vertex="1">
          <mxGeometry as="geometry" x="380" y="335" width="240" height="150" />
