          <mxGeometry as="geometry" x="106.0" y="10" width="28" height="28" />
        </mxCell>
        <mxCell id="user" parent="1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Internal user&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5c5c5c&quot;&gt;Colleagues, APEX companies,&lt;br&gt;contractors&lt;/span&gt;" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;aspect=fixed;imageAspect=0;fontSize=12;fontColor=#1c1c1c;spacingTop=6;image=data:image/svg+xml,;" vertex="1">
