        <mxCell id="e1" parent="1" value="Routes via peering, private DNS" style="html=1;rounded=0;edgeStyle=none;endFill=1;strokeColor=#3f3f52;strokeWidth=1;fontSize=10;fontColor=#1c1c1c;labelBackgroundColor=#ffffff;endArrow=classic;endSize=6;" edge="1" source="hub" target="sys">
