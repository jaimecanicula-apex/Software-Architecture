        <mxCell id="title" parent="1" vertex="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Public sign-in static website&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#b8321f&quot;&gt;C4 level 2: Containers&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1c1c1c;strokeColor=none;fillColor=none;">
