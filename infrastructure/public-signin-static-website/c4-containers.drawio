        <mxCell id="39" edge="1" parent="1" source="19" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endFill=1;strokeColor=#3f3f52;strokeWidth=1;fontSize=10;fontColor=#1c1c1c;labelBackgroundColor=#ffffff;endArrow=classic;exitX=0.500;exitY=0.000;exitPerimeter=0;entryX=0.500;entryY=1.000;entryPerimeter=0;endSize=6;jettySize=auto;" target="15" value="Queries">
