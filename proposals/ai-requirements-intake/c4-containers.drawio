  <diagram name="C4 L2 Containers - AI requirements intake" id="c4-containers">
    <mxGraphModel dx="1700" dy="2280" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2280" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;AI requirements intake and SDLC integration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#b8321f&quot;&gt;C4 level 2: Containers (proposal v0.2)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1c1c1c;strokeColor=none;fillColor=none;" vertex="1">
          <mxGeometry as="geometry" x="20" y="10" width="1660" height="50" />
        </mxCell>
        <mxCell id="description" parent="1" value="Phase 1, one product and one engineering team. A request enters through ServiceNow or the Power Apps form. Power Automate files the dossier in SharePoint and queues it; the analyser function triages, structures and pre-validates it against security-trimmed product context with a pinned model. Product Owner and Software Architects review in Power Apps and accept one exact version; the publisher function re-checks it and is the only component that writes to Azure DevOps. Intake acceptance is not production change approval." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5c5c5c;strokeColor=none;fillColor=none;" vertex="1">
          <mxGeometry as="geometry" x="20" y="62" width="1660" height="60" />
        </mxCell>
        <mxCell id="pp" parent="1" value="Power Platform + SharePoint site · managed environment, DLP policy, flows owned by a service account" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;fillColor=#f7f7ff;strokeColor=#b9b9e6;dashed=1;dashPattern=4 4;fontColor=#1c1c1c;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1">
          <mxGeometry as="geometry" x="290" y="190" width="1130" height="410" />
        </mxCell>
