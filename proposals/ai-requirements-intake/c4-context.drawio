  <diagram name="C4 L1 Context - AI requirements intake" id="c4-context">
    <mxGraphModel dx="1000" dy="760" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1000" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;AI requirements intake and SDLC integration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#b8321f&quot;&gt;C4 level 1: System context (proposal v0.2)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1c1c1c;strokeColor=none;fillColor=none;" vertex="1">
          <mxGeometry as="geometry" x="20" y="10" width="960" height="50" />
        </mxCell>
        <mxCell id="description" parent="1" value="People raise or review requests. The system drafts a structured, pre-validated version using the product&amp;#x27;s own architecture notes, waits for a Product Owner and a Software Architect to accept one exact version, and only then creates a work item in Azure DevOps. ServiceNow stays the source record and SLA clock; Entra ID signs everyone in." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5c5c5c;strokeColor=none;fillColor=none;" vertex="1">
          <mxGeometry as="geometry" x="20" y="62" width="960" height="60" />
        </mxCell>
        <mxCell id="boundary" parent="1" value=" AI requirements intake · phase 1, one product, one team " style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#e6e6ea;strokeColor=#a9a9b4;strokeWidth=1;fontColor=#ffffff;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;labelBackgroundColor=#1c1c1c;" vertex="1">
