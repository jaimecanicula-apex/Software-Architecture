        <mxCell id="2" parent="1" vertex="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Privately accessible static website&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#b8321f&quot;&gt;Sequence diagram&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#1c1c1c;">
          <mxGeometry x="20" y="10" width="1410" height="50" as="geometry" />
        </mxCell>
        <mxCell id="3" parent="1" vertex="1" value="Internal users on the APEX network reach the site only through its private endpoint; public access is off. Every page except /healthz.html needs an APEX Entra sign-in, and only assigned groups get in. A probe inside the VNet checks the health page and reports over Monitor Private Link." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5c5c5c;">
          <mxGeometry x="20" y="62" width="1410" height="60" as="geometry" />
        </mxCell>
