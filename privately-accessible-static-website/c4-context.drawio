  <diagram name="C4 L1 System context - privately accessible" id="c4-context">
    <mxGraphModel dx="1000" dy="650" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1000" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Privately accessible static website&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#b8321f&quot;&gt;C4 level 1: System context&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#1c1c1c;strokeColor=none;fillColor=none;">
          <mxGeometry x="20" y="10" width="960.0" height="50" as="geometry" />
        </mxCell>
        <mxCell id="description" parent="1" vertex="1" value="Internal users sign in with APEX Entra ID and browse the site over the APEX network. Monitoring viewers open its dashboard and a platform engineer provisions it with Terraform. A delivery pipeline uploads app-internal, the APEX network carries private traffic, Entra ID authenticates users and alerts go to notification channels." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5c5c5c;strokeColor=none;fillColor=none;">
          <mxGeometry x="20" y="62" width="960.0" height="60" as="geometry" />
        </mxCell>
